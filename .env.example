# Gitea admin account created by the gitea-init service.
# Local development credentials for the Gitea container.
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=ChangeMe123!
GITEA_ADMIN_EMAIL=admin@example.local

# Repository created and seeded with sample issues by the seed service.
GITEA_REPO_NAME=bug-triage-service

# Which LLM backend the triage service classifies with: "openai" (default) or "ollama".
# Both go through the OpenAI SDK - Ollama exposes an OpenAI-compatible endpoint - so switching
# is just this one variable plus each backend's own settings below.
LLM_PROVIDER=openai

# OpenAI backend (used when LLM_PROVIDER=openai).
OPENAI_API_KEY=
# Optional overrides; defaults to gpt-5.4-nano against the standard OpenAI base URL.
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama backend (used when LLM_PROVIDER=ollama). Defaults reach an Ollama instance on the
# Docker host and use a locally-pulled qwen3.5 model.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3.5:latest
